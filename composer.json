{
    "name": "ikhbarnuridev/filament-mega-menu",
    "description": "Topbar navigation groups that overflow onto a second row become a full-width mega menu instead.",
    "keywords": [
        "ikhbarnuridev",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "mega-menu"
    ],
    "homepage": "https://github.com/ikhbarnuridev/filament-mega-menu",
    "license": "MIT",
    "authors": [
        {
            "name": "ikhbarnuridev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "orchestra/workbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ikhbarnuridev\\FilamentMegaMenu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ikhbarnuridev\\FilamentMegaMenu\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "build": [
            "@php vendor/bin/testbench filament:assets",
            "@php vendor/bin/testbench workbench:create-sqlite-db --force",
            "@php vendor/bin/testbench migrate --force --seed --seeder=Workbench\\\\Database\\\\Seeders\\\\DatabaseSeeder"
        ],
        "serve": "@php vendor/bin/testbench serve",
        "lint": "pint",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ikhbarnuridev\\FilamentMegaMenu\\FilamentMegaMenuServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
